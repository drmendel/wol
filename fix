$q={param($m)$r='';while($r-notin'y','n'){$r=(Read-Host "$m [y/n]").Trim().ToLower()};$r-eq'y'};$hb=(gp 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Power'-EA 0).HiberbootEnabled;if($hb -eq 1 -and(&$q 'Disable Fast Startup & Hibernation?')){powercfg /h off|Out-Null;sp 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Power' HiberbootEnabled 0};powercfg /devicequery wake_armed|?{$_-and$_-ne'NONE'-and$_-notmatch'Ethernet|GbE|2\.5GbE|Intel|Realtek|Wi-Fi|Wireless|LAN|NIC'}|%{$d=$_;if(&$q "Disable wake on '$d'?"){powercfg /devicedisablewake "$d"|Out-Null}};Get-NetAdapter -Physical|?{$_.Status-eq'Up'}|%{$n=$_;$id=$n.PnPDeviceID;$we=gcim -N root\wmi MSPower_DeviceWakeEnable -EA 0|?{$_.InstanceName -like"*$id*"}|select -First 1;if($we -and -not $we.Enable -and(&$q "Enable Allow Wake on $($n.Name)?")){Set-CimInstance -InputObject $we -Property @{Enable=$true}};$mo=gcim -N root\wmi MSNdis_DeviceWakeOnMagicPacketOnly -EA 0|?{$_.InstanceName -like"*$id*"}|select -First 1;if($mo -and -not $mo.EnableWakeOnMagicPacketOnly -and(&$q "Enable Magic Packet Only on $($n.Name)?")){Set-CimInstance -InputObject $mo -Property @{EnableWakeOnMagicPacketOnly=$true}};Get-NetAdapterAdvancedProperty $n.Name -EA 0|%{$p=$_;$v=$p.DisplayValue;if($p.DisplayName -match'Wake on Magic Packet$|Shutdown Wake-On-Lan|power off state'-and$v-notmatch'Enabled|Engedélyezve'){$tv=$p.ValidDisplayValues|?{$_-match'Enabled|Engedélyezve'}|select -First 1;if($tv -and(&$q "Set '$($p.DisplayName)' on $($n.Name) to '$tv'?")){Set-NetAdapterAdvancedProperty -Name $n.Name -DisplayName $p.DisplayName -DisplayValue $tv}}elseif($p.DisplayName -match'Wake on Pattern Match|Wake on Link|Energy-Efficient Ethernet|Green Ethernet'-and$v-notmatch'Disabled|Letiltva'){$tv=$p.ValidDisplayValues|?{$_-match'Disabled|Letiltva'}|select -First 1;if($tv -and(&$q "Set '$($p.DisplayName)' on $($n.Name) to '$tv'?")){Set-NetAdapterAdvancedProperty -Name $n.Name -DisplayName $p.DisplayName -DisplayValue $tv}}}}
