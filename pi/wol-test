#!/bin/bash
# wol-test: Wake-on-LAN isolation test (Raspberry Pi cabled directly to the PC on eth0)
# Install with pi/setup.sh. Docs: CHECKLIST.md section 5.
set -u
export LC_ALL=C.UTF-8
[ -r /etc/wol-test.conf ] && . /etc/wol-test.conf
CONF_MAC=$(tr 'A-F' 'a-f' <<<"${MAC:-auto}")   # "auto": learn the PC's MAC from the DHCP lease
IP=${IP:-}                   # optional: if empty, the PC's IP is taken from the DHCP lease
PORT=${PORT:-9}              # UDP port of the magic packet (UpSnap default: 9)
IFACE=${IFACE:-eth0}
WAIT=${WAIT:-120}            # seconds to wait for the PC to come up after each shot
STATE=/var/lib/wol-test
LOG=/var/log/wol-test.log    # detailed, timestamped evidence
PCAP=/var/log/wol-test       # one capture per shot
RUNS=$PCAP/runs.tsv          # one line per run, used by "wol-test report"

[ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$@"
mkdir -p "$STATE" "$PCAP"

# ---------------------------------------------------------------- presentation
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m' TTY=1
else
  B='' D='' R='' G='' Y='' C='' N='' TTY=''
fi
OK="${G}✔${N}" BAD="${R}✘${N}" WARN="${Y}⚠${N}"
W=66
rep()    { local i; for ((i = 0; i < $2; i++)); do printf '%s' "$1"; done; }
pad()    { printf '%s%*s' "$1" $(($2 - ${#1})) ''; }          # pad by visible chars
rule()   { printf '  %s%s%s\n' "$D" "$(rep ─ $W)" "$N"; }
banner() {
  local gap=$((W - 6 - ${#1} - ${#2}))
  printf '\n  %s╭%s╮%s\n' "$C" "$(rep ─ $((W - 2)))" "$N"
  printf '  %s│%s  %s%s%s%*s%s%s%s  %s│%s\n' "$C" "$N" "$B" "$1" "$N" $gap '' "$D" "$2" "$N" "$C" "$N"
  printf '  %s╰%s╯%s\n\n' "$C" "$(rep ─ $((W - 2)))" "$N"
}
kv()     { printf '  %s%s%s %s\n' "$D" "$(pad "$1" 11)" "$N" "$2"; }
step()   { printf '\n  %s%s %s%s  %s%s%s\n' "$C$B" "$1" "$2" "$N" "$D" "$3" "$N"; }
item()   { printf '     %s%s%s %s\n' "$D" "$(pad "$1" 17)" "$N" "$2"; }
note()   { printf '     %s\n' "$*"; }
clr()    { [ -n "$TTY" ] && printf '\r\e[2K'; return 0; }
log()    { echo "$(date '+%F %T') $*" >> "$LOG"; }
die()    { # die <exit code> <headline> [detail lines...]
  local code=$1 head=$2; shift 2
  log "!! $head $*"
  printf '\n  %s %s%s%s\n' "$BAD" "$B" "$head" "$N"
  local l; for l in "$@"; do printf '    %s%s%s\n' "$D" "$l" "$N"; done
  echo; exit "$code"
}
hdur() {
  local s=$1
  if   [ "$s" -lt 0 ];     then echo "unknown"
  elif [ "$s" -ge 3600 ];  then printf '%d h %02d min' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ];    then printf '%d min %02d s' $((s / 60)) $((s % 60))
  else printf '%d s' "$s"; fi
}

# ---------------------------------------------------------------- target
LEASES=/var/lib/NetworkManager/dnsmasq-$IFACE.leases   # "<expiry> <mac> <ip> <host> <id>"

# PC MAC: configured > newest DHCP lease (only the PC is on the direct cable) > last MAC seen
pc_mac() {
  [ "$CONF_MAC" != auto ] && { echo "$CONF_MAC"; return; }
  local m; m=$(sort -n "$LEASES" 2>/dev/null | tail -1 | awk '{print tolower($2)}')
  [ -n "$m" ] && { echo "$m" > "$STATE/pc_mac"; echo "$m"; return; }
  cat "$STATE/pc_mac" 2>/dev/null
}
# PC IP: configured > current DHCP lease for the MAC > last IP seen
pc_ip() {
  [ -n "$IP" ] && { echo "$IP"; return; }
  local l; l=$(awk -v m="$(pc_mac)" 'tolower($2)==m {print $3}' "$LEASES" 2>/dev/null | tail -1)
  [ -n "$l" ] && { echo "$l" > "$STATE/pc_ip"; echo "$l"; return; }
  cat "$STATE/pc_ip" 2>/dev/null
}
MAC=$(pc_mac)

# Awake = answers ping, or sends IPv4 traffic within <secs> (Windows often blocks ping).
# ARP and IPv6 are ignored on purpose: NIC ARP / NS offload answers them while asleep.
alive() {
  local secs=${1:-3} t m; t=$(pc_ip); m=$(pc_mac)
  [ -n "$t" ] && ping -c1 -W1 -I "$IFACE" "$t" >/dev/null 2>&1 && return 0
  [ -n "$m" ] && timeout "$secs" tcpdump -i "$IFACE" -c1 -nn "ether src $m and ip" >/dev/null 2>&1
}
asleep_secs() {
  [ -s "$STATE/last_online" ] || { echo -1; return; }
  echo $(( $(date +%s) - $(cat "$STATE/last_online") ))
}
link_up()    { [ "$(cat /sys/class/net/"$IFACE"/carrier 2>/dev/null)" = 1 ]; }
link_speed() { cat /sys/class/net/"$IFACE"/speed 2>/dev/null; }
link_pretty() {
  link_up || { echo "${R}● no link${N}"; return; }
  local s; s=$(link_speed)
  if [ "${s:-0}" -le 100 ]; then echo "${G}● up${N}, $s Mb/s ${D}(low-power wake mode while asleep)${N}"
  else echo "${G}● up${N}, $s Mb/s"; fi
}
neigh_state() { ip neigh show "$1" dev "$IFACE" 2>/dev/null | awk 'NR==1 {print $NF}'; }
neigh_pretty() {
  case "$1" in
    PERMANENT)                     echo "${C}pinned${N} ${D}(IP → MAC fixed by the test)${N}" ;;
    REACHABLE|STALE|DELAY|PROBE)   echo "${G}known${N} ${D}($1)${N}" ;;
    *)                             echo "${R}forgotten${N} ${D}(${1:-no entry})${N}" ;;
  esac
}

need_target() {
  MAC=$(pc_mac); TARGET=$(pc_ip)
  [ -n "$MAC" ] && [ -n "$TARGET" ] && return
  die 3 "PC MAC / IP unknown" "Plug the cable in and wake the PC once so it gets a DHCP lease," \
        "or set MAC / IP in /etc/wol-test.conf."
}
check_link() {
  link_up && return
  die 2 "No link on $IFACE" "Cable unplugged, or the PC's network card has no power while off" \
        "(BIOS: ErP / Deep Sleep, CHECKLIST §1, §4). No packet can wake it in this state."
}
# The packet must leave through eth0. If another profile owns eth0 (wrong subnet),
# the kernel routes it out of Wi-Fi instead and the result would be meaningless.
check_route() {
  ip route get "$TARGET" 2>/dev/null | grep -q " dev $IFACE " && return
  die 4 "$TARGET is not reachable via $IFACE" \
        "$IFACE has $(ip -4 -br addr show "$IFACE" | awk '{print $3}'): the wrong network profile is active." \
        "Fix: sudo nmcli con up wol-direct   (then wake the PC once)"
}

# ---------------------------------------------------------------- shots
declare -A TITLE=([unicast]="Unicast" [static]="Unicast, ARP pinned" [raw]="Raw Ethernet")
declare -A SUB=([unicast]="exactly what UpSnap sends" [static]="same packet, IP → MAC fixed first" [raw]="etherwake, no IP, no ARP")

# Capture everything on eth0 while sending, then count what really hit the wire.
shot() {
  local name=$1; shift
  SHOT_PCAP="$PCAP/$(date +%Y%m%d-%H%M%S)-$name.pcap"
  tcpdump -i "$IFACE" -nn -U -w "$SHOT_PCAP" 2>/dev/null & local tp=$!
  sleep 1
  SHOT_NEIGH=$(neigh_state "$TARGET")
  "$@" >/dev/null 2>&1
  sleep 4; kill $tp 2>/dev/null; wait $tp 2>/dev/null
  local d; d=$(tcpdump -r "$SHOT_PCAP" -nn -e 2>/dev/null)
  SHOT_ARP=$(grep -c "who-has $TARGET " <<<"$d")
  SHOT_UDP=$(grep -c "> $TARGET.$PORT: UDP" <<<"$d")
  SHOT_RAW=$(grep -ci "0x0842" <<<"$d")
  log "[$name] arp-before=${SHOT_NEIGH:-none} sent='$*' wire: arp-who-has=$SHOT_ARP udp-magic=$SHOT_UDP raw-0842=$SHOT_RAW pcap=$SHOT_PCAP"
}
send_unicast() { shot unicast wakeonlan -i "$TARGET" -p "$PORT" "$MAC"; }
send_static()  {
  ip neigh replace "$TARGET" lladdr "$MAC" dev "$IFACE" nud permanent
  shot static wakeonlan -i "$TARGET" -p "$PORT" "$MAC"
  ip neigh del "$TARGET" dev "$IFACE" 2>/dev/null
}
send_raw()     { shot raw etherwake -i "$IFACE" "$MAC"; }

wait_wake() {
  local start=$SECONDS
  while [ $((SECONDS - start)) -lt "$WAIT" ]; do
    [ -n "$TTY" ] && printf '\r     %s%s%s %ss / %ss ' "$D" "$(pad "Waiting for PC" 17)" "$N" $((SECONDS - start)) "$WAIT"
    if alive; then WOKE_AFTER=$((SECONDS - start)); clr; return 0; fi
  done
  clr; return 1
}

declare -A RES=([unicast]=- [static]=- [raw]=-)
try() {
  local n=$1 mode=$2 cnt
  step "$n" "${TITLE[$mode]}" "${SUB[$mode]}"
  "send_$mode"
  item "ARP entry before" "$(neigh_pretty "$SHOT_NEIGH")"
  if [ "$mode" = raw ]; then
    cnt=$SHOT_RAW; item "On the wire" "$([ "$cnt" -gt 0 ] && echo "$G" || echo "$R")${cnt}× WoL frame${N}"
  else
    cnt=$SHOT_UDP; item "On the wire" "${SHOT_ARP}× ARP request  ·  $([ "$cnt" -gt 0 ] && echo "$G" || echo "$R")${cnt}× magic packet${N}"
  fi
  [ "$cnt" -eq 0 ] && note "$WARN ${Y}Magic packet never left the Pi${N} ${D}(nobody answered ARP, the kernel dropped it)${N}"
  if wait_wake; then
    note "$OK ${G}${B}PC woke up${N} ${D}after ${WOKE_AFTER} s${N}"
    RES[$mode]="woke:$WOKE_AFTER"; log "[$mode] PC WOKE UP after ${WOKE_AFTER}s"; return 0
  fi
  note "$BAD No wake within $WAIT s"
  RES[$mode]=$([ "$cnt" -eq 0 ] && echo notsent || echo nowake); log "[$mode] no wake"
  return 1
}

declare -A VERDICT=(
  [unicast]="The PC is fine.|A plain unicast (UpSnap-style) woke it. No ARP problem on this path."
  [static]="The PC is fine. The expired ARP entry is the problem.|Same packet twice: without the ARP entry it never left the Pi,|with the ARP entry pinned it woke the PC."
  [raw]="The PC is fine. The problem is on the UDP / ARP path.|Only a raw layer-2 frame woke it."
  [none]="The PC did not wake over a direct cable.|Check the PC / BIOS / network card settings (CHECKLIST §1–§3)."
)
declare -A SHORT=([unicast]="PC fine" [static]="ARP expiry" [raw]="UDP/ARP path" [none]="PC config")

result_box() {
  local key=$1 mark head rest x l
  [ "$key" = none ] && mark=$BAD || mark=$OK
  head=${VERDICT[$key]%%|*}; rest=${VERDICT[$key]#*|}
  echo; rule
  printf '  %sRESULT%s   %s %s%s%s\n' "$B" "$N" "$mark" "$B" "$head" "$N"
  IFS='|' read -ra l <<<"$rest"
  for x in "${l[@]}"; do printf '             %s\n' "$x"; done
  rule
  printf '  %sEvidence%s wol-test report  ·  %s/*.pcap\n\n' "$D" "$N" "$PCAP"
}

cell() { # cell <result> <width>
  case "$1" in
    woke:*)  printf '%s%s%s' "$G" "$(pad "✔ woke, ${1#woke:} s" "$2")" "$N" ;;
    notsent) printf '%s%s%s' "$R" "$(pad "✘ never sent" "$2")" "$N" ;;
    nowake)  printf '%s%s%s' "$R" "$(pad "✘ sent, no wake" "$2")" "$N" ;;
    *)       printf '%s%s%s' "$D" "$(pad "·" "$2")" "$N" ;;
  esac
}

# ---------------------------------------------------------------- commands
case "${1:-help}" in
  status)
    t=$(pc_ip)
    banner "Wake-on-LAN test · status" "$(date '+%F %H:%M')"
    kv "PC"        "${B}${MAC:-MAC unknown}${N}  →  ${B}${t:-IP unknown}${N}  ${D}(UDP $PORT$( [ "$CONF_MAC" = auto ] && echo ", MAC auto"))${N}"
    kv "Cable"     "$(link_pretty)"
    kv "Pi eth0"   "$(ip -4 -br addr show "$IFACE" | awk '{print $3}')"
    [ -n "$t" ] && kv "ARP entry" "$(neigh_pretty "$(neigh_state "$t")")"
    if alive 8; then kv "PC state" "${G}● awake${N}"
    else kv "PC state" "${Y}● asleep${N} ${D}for $(hdur "$(asleep_secs)")${N}"; fi
    if [ -s "$RUNS" ] && [ "$(wc -l < "$RUNS")" -gt 1 ]; then
      IFS=$'\t' read -r d _ _ _ _ _ _ _ v < <(tail -1 "$RUNS")
      kv "Last run" "$d  ·  ${B}${SHORT[$v]:-$v}${N}"
    fi
    echo ;;

  run)          # the full experiment: UpSnap-style unicast first, then the controls
    check_link; need_target; check_route
    banner "Wake-on-LAN test" "$(date '+%F %H:%M')"
    if alive 15; then die 1 "The PC is awake" "Put it to sleep (or shut it down) first, then run the test after the wait."; fi
    s=$(asleep_secs); sp=$(link_speed)
    kv "PC"     "${B}$MAC${N}  →  ${B}$TARGET${N}  ${D}(UDP $PORT)${N}"
    kv "Asleep" "$(hdur "$s")"
    kv "Cable"  "$(link_pretty)"
    log "===== WoL test run | PC $MAC @ $TARGET | asleep $(hdur "$s") | link ${sp}Mb/s ====="
    if   try 1 unicast; then key=unicast
    elif try 2 static;  then key=static
    elif try 3 raw;     then key=raw
    else key=none; fi
    [ -s "$RUNS" ] || printf 'date\tasleep_s\tlink\tmac\tip\tunicast\tstatic\traw\tverdict\n' > "$RUNS"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %H:%M')" "$s" "$sp" "$MAC" "$TARGET" \
      "${RES[unicast]}" "${RES[static]}" "${RES[raw]}" "$key" >> "$RUNS"
    log "RESULT: ${SHORT[$key]} :: ${VERDICT[$key]//|/ }"
    result_box "$key" ;;

  report)       # every run in one table: the page to show
    W=93
    banner "Wake-on-LAN test results" "$(date '+%F %H:%M')"
    if ! [ -s "$RUNS" ] || [ "$(wc -l < "$RUNS")" -le 1 ]; then note "No runs yet. Start one with: wol-test run"; echo; exit 0; fi
    printf '  %s%s %s %s %s %s %s%s\n' "$B" "$(pad Date 16)" "$(pad Asleep 13)" "$(pad "1 UpSnap" 16)" \
      "$(pad "2 ARP pinned" 16)" "$(pad "3 Raw" 16)" "Verdict" "$N"
    rule
    while IFS=$'\t' read -r d s sp mac ip u st rw v; do
      printf '  %s %s %s %s %s %s%s%s\n' "$(pad "$d" 16)" "$(pad "$(hdur "$s")" 13)" "$(cell "$u" 16)" \
        "$(cell "$st" 16)" "$(cell "$rw" 16)" "$B" "${SHORT[$v]:-$v}" "$N"
    done < <(tail -n +2 "$RUNS")
    rule
    IFS=$'\t' read -r _ _ _ mac ip _ _ _ v < <(tail -1 "$RUNS")
    printf '  %sPC%s      %s → %s  ·  direct cable to the Pi, no switch or router\n' "$D" "$N" "$mac" "$ip"
    printf '  %sLatest%s  %s%s%s\n\n' "$D" "$N" "$B" "${VERDICT[$v]%%|*}" "$N" ;;

  unicast|static|raw)
    check_link; need_target; check_route
    banner "Wake-on-LAN test · single shot" "$(date '+%F %H:%M')"
    try "·" "$1"; echo ;;

  monitor)      # systemd service: track when the PC goes to sleep / wakes up
    prev=""
    while true; do
      if alive 10; then date +%s > "$STATE/last_online"; cur=AWAKE; else cur=ASLEEP; fi
      [ "$cur" != "$prev" ] && log "[monitor] PC $(pc_mac) $(pc_ip) is now $cur"
      prev=$cur; sleep 5
    done ;;

  log) tail -n "${2:-40}" "$LOG" ;;

  *)
    banner "wol-test" "Wake-on-LAN isolation test"
    kv "PC" "${MAC:-MAC not learned yet}  ·  $IFACE  ·  UDP $PORT"
    echo
    kv "status"  "cable, ARP entry, how long the PC has been asleep"
    kv "run"     "${B}full test${N}: 1 unicast (UpSnap) → 2 ARP pinned → 3 raw"
    kv "report"  "${B}all runs in one table${N} (the page to show)"
    kv "unicast" "only shot 1   ·   static: only shot 2   ·   raw: only shot 3"
    kv "log [n]" "detailed log with timestamps"
    echo
    kv "Files" "${D}/etc/wol-test.conf  ·  $LOG  ·  $PCAP/${N}"
    echo ;;
esac
